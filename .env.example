# GEMINI_API_KEY: Required for Gemini AI agent calls (discovery, autofill, resume parsing).
# Free tier ready: the app caches + falls back gracefully when quota is exhausted.
GEMINI_API_KEY="your_gemini_api_key"

# Auth: HMAC secret for stateless session tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET="replace_with_long_random_string"

# Supabase: durable storage for the JSON document snapshot (Free tier OK).
# Create at supabase.com → Project Settings → API keys.
# The SECRET key bypasses Row Level Security — server-side only, never ship to browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Length: Serverless (Vercel) entry: npm run build outputs dist/.
# APP_URL is used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"
