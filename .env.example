# ── AI ────────────────────────────────────────────────────────────────────────
# Gemini API key for the agent calls (discovery, autofill, resume parsing).
# Free tier ready: the app degrades 3.8-flash → 3.5-flash → mock automatically.
GEMINI_API_KEY="your_gemini_api_key"

# ── Storage ───────────────────────────────────────────────────────────────────
# Supabase: durable JSONB snapshot storage (free tier OK).
# Create at supabase.com → Project Settings → API keys.
# The SECRET key bypasses RLS — for server-side only, never ship to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# ── Auth ──────────────────────────────────────────────────────────────────────
# HMAC secret for stateless bearer tokens and OAuth state. REQUIRED in production.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET="replace_with_long_random_string"

# Admin credentials — derived from env on every boot; never stored in the repo.
# If omitted, a random admin password is generated and logged once to the server
# console. Set strong values before going public.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace_with_strong_random_password"

# ── Ops ───────────────────────────────────────────────────────────────────────
# Bearer guard for the daily discovery sweep (/api/cron/discovery-sweep).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="replace_with_long_random_string"

# Self-referential links (used for OAuth callbacks and absolute URLs).
APP_URL="https://your-domain.example"

# ── Optional: open-source fallback tier ("Sign in with Google" section below) ─
# When BOTH Gemini tiers are quota-exhausted, discovery degrades to a free
# open-source model hosted on Groq (Llama 3.3 70B by default) before the mock.
# Get a free key at console.groq.com → API Keys.
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"

# ── Optional: "Sign in with Google" ───────────────────────────────────────────
# When both are set, the Google button appears automatically. In Google Cloud
# console, add authorized origin (your https:// domain) and redirect URI
# (<your-domain>/api/auth/google/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
